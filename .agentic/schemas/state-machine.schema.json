{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobilka.local/schemas/state-machine.schema.json",
  "title": "Workflow state machine policy",
  "type": "object",
  "required": ["schemaVersion", "initialState", "terminalStates", "transitions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "initialState": { "type": "string", "minLength": 1 },
    "terminalStates": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "transitions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["to"],
          "properties": {
            "to": { "type": "string", "minLength": 1 },
            "requiresApproval": { "enum": ["specification", "acceptance", "release"] },
            "requiresDigest": { "enum": ["spec", "environment", "evidence", "releaseArtifact"] },
            "requiresReadyEnvironment": { "type": "boolean" },
            "createsRevision": { "type": "boolean" },
            "invalidateDigests": {
              "type": "array",
              "uniqueItems": true,
              "items": { "enum": ["spec", "environment", "evidence", "releaseArtifact"] }
            },
            "invalidateApprovals": {
              "type": "array",
              "uniqueItems": true,
              "items": { "enum": ["specification", "acceptance", "release"] }
            }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "additionalProperties": false
}
