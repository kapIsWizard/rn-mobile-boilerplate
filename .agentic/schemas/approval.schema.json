{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobilka.local/schemas/approval.schema.json",
  "title": "Human approval",
  "type": "object",
  "required": ["schemaVersion", "gate", "status", "source", "approvedBy", "approvedAt", "digestSnapshot"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "gate": { "enum": ["specification", "acceptance", "release"] },
    "status": { "const": "approved" },
    "source": { "const": "human-interaction" },
    "approvedBy": { "type": "string", "minLength": 1 },
    "approvedAt": { "type": "string", "format": "date-time" },
    "digestSnapshot": {
      "type": "object",
      "properties": {
        "spec": { "type": ["string", "null"] },
        "environment": { "type": ["string", "null"] },
        "evidence": { "type": ["string", "null"] },
        "releaseArtifact": { "type": ["string", "null"] }
      }
    }
  },
  "additionalProperties": false
}
