{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobilka.local/schemas/visual-reference-contract.schema.json",
  "title": "Repository visual reference contract",
  "type": "object",
  "required": ["schemaVersion", "reference", "baselinePolicy", "environment", "tokens", "screens", "allowedDifferences", "thresholds", "requiredElements"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "reference": { "type": "string", "minLength": 1 },
    "baselinePolicy": {
      "type": "object",
      "required": ["automaticUpdate", "requiresHumanApproval", "implementationScreenshotCannotBecomeReference"],
      "properties": {
        "automaticUpdate": { "const": false },
        "requiresHumanApproval": { "const": true },
        "implementationScreenshotCannotBecomeReference": { "const": true }
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": ["locale", "appearance", "fontScale", "orientation", "reduceMotion", "fixtures"],
      "properties": {
        "locale": { "type": "string", "minLength": 1 },
        "appearance": { "enum": ["light", "dark"] },
        "fontScale": { "type": "number", "exclusiveMinimum": 0 },
        "orientation": { "enum": ["portrait", "landscape"] },
        "reduceMotion": { "type": "boolean" },
        "fixtures": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "tokens": {
      "type": "object",
      "required": ["canvas", "surface", "text", "muted", "primary", "danger", "radius", "spacing"],
      "properties": {
        "canvas": { "$ref": "#/$defs/color" },
        "surface": { "$ref": "#/$defs/color" },
        "text": { "$ref": "#/$defs/color" },
        "muted": { "$ref": "#/$defs/color" },
        "primary": { "$ref": "#/$defs/color" },
        "danger": { "$ref": "#/$defs/color" },
        "radius": {
          "type": "object",
          "required": ["ios", "android"],
          "properties": {
            "ios": { "type": "number", "minimum": 0 },
            "android": { "type": "number", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "spacing": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "number", "exclusiveMinimum": 0 }
        }
      },
      "additionalProperties": false
    },
    "screens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["platform", "state", "referenceRegion"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "platform": { "enum": ["ios", "android"] },
          "state": { "type": "string", "minLength": 1 },
          "referenceRegion": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "allowedDifferences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["region", "strategy"],
        "properties": {
          "region": { "type": "string", "minLength": 1 },
          "strategy": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "thresholds": {
      "type": "object",
      "required": ["semantic", "regionalPixelDifferencePercent", "structuralSimilarityMinimum", "humanReviewRequiredForChangedRegions"],
      "properties": {
        "semantic": { "type": "string", "minLength": 1 },
        "regionalPixelDifferencePercent": { "type": "number", "minimum": 0, "maximum": 100 },
        "structuralSimilarityMinimum": { "type": "number", "minimum": 0, "maximum": 1 },
        "humanReviewRequiredForChangedRegions": { "const": true }
      },
      "additionalProperties": false
    },
    "requiredElements": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "color": { "type": "string", "pattern": "^#[A-Fa-f0-9]{6}$" }
  },
  "additionalProperties": false
}
