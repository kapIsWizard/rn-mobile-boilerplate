{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobilka.local/schemas/schema-registry.schema.json",
  "title": "Controlled JSON schema ownership registry",
  "type": "object",
  "required": ["schemaVersion", "entries", "negativeFixtures"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "glob"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["schema", "exclusion"] },
          "glob": { "type": "string", "minLength": 1 },
          "schemaId": { "type": "string", "format": "uri" },
          "owner": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "expiresAt": { "type": "string", "format": "date-time" }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "schema" } }, "required": ["kind"] },
            "then": { "properties": { "schemaId": {} }, "required": ["schemaId"] }
          },
          {
            "if": { "properties": { "kind": { "const": "exclusion" } }, "required": ["kind"] },
            "then": {
              "properties": { "owner": {}, "reason": {}, "expiresAt": {} },
              "required": ["owner", "reason", "expiresAt"]
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "negativeFixtures": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "\\.json$" }
    }
  },
  "additionalProperties": false
}
