{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobilka.local/schemas/control-plane-evidence.schema.json",
  "title": "Phase 0 hardening evidence record",
  "type": "object",
  "required": ["schemaVersion", "runId", "commitSha", "generatedAt", "requirements", "checks", "knownGaps", "result"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "commitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^REQ-HARD-\\d{3}$" },
          "status": { "enum": ["verified", "partially-verified", "failed", "requires-human"] },
          "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "reason": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status", "evidence"],
        "properties": {
          "status": { "enum": ["passed", "failed", "requires-human", "not-required"] },
          "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "reason": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "knownGaps": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "result": { "enum": ["verified", "partially-verified", "failed", "requires-human"] }
  },
  "additionalProperties": false
}
