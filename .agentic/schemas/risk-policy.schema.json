{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobilka.local/schemas/risk-policy.schema.json",
  "title": "Risk policy",
  "type": "object",
  "required": ["schemaVersion", "dimensions", "profiles", "forceCritical"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "dimensions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "profiles": {
      "type": "object",
      "required": ["fast", "standard", "critical"],
      "properties": {
        "fast": { "$ref": "#/$defs/profile" },
        "standard": { "$ref": "#/$defs/profile" },
        "critical": { "$ref": "#/$defs/profile" }
      },
      "additionalProperties": false
    },
    "forceCritical": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "required": ["score", "requiredVerification"],
      "properties": {
        "score": {
          "type": "object",
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "integer", "minimum": 0 },
            "max": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "requiredVerification": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
