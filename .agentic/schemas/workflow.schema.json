{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobilka.local/schemas/workflow.schema.json",
  "title": "Agentic workflow definition",
  "type": "object",
  "required": ["schemaVersion", "name", "preflightProfile", "humanGates", "stages"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "preflightProfile": { "enum": ["control-plane", "mobile-development", "mobile-e2e", "mobile-release"] },
    "humanGates": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["specification", "acceptance", "release"] }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
